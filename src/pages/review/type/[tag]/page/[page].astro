---
// 種類別一覧の 2 ページ目以降（/review/type/single-malt/page/2/ ...）。1 ページ目は /review/type/single-malt/
import Layout from '@/layouts/Layout.astro';
import ReviewListPage from '@/components/pages/review/ReviewListPage.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { reviewTags } from '@/data/review/tag';
import { getSortedReviewPosts } from '@/utils/review/posts';
import { getReviewTagLink } from '@/utils/review/slugs';
import { getRestPages, getTotalPages, slicePage } from '@/utils/review/pagination';

export async function getStaticPaths() {
  const reviewPosts = await getCollection('review', ({ data }) => data.draft === false);

  return reviewTags.flatMap((tag) => {
    const sorted = getSortedReviewPosts(reviewPosts.filter((post) => (post.data.tags as string[]).includes(tag.slug)));
    return getRestPages(sorted.length).map((page) => ({
      params: { tag: tag.slug, page: String(page) },
      props: { tag, page, posts: slicePage(sorted, page), total: sorted.length, allPosts: reviewPosts },
    }));
  });
}

interface Props {
  tag: (typeof reviewTags)[number];
  page: number;
  posts: CollectionEntry<'review'>[];
  total: number;
  allPosts: CollectionEntry<'review'>[];
}

const { tag, page, posts, total, allPosts } = Astro.props;
const title = `${tag.label}ウイスキーのレビュー一覧`;
const breadcrumb = [{ label: 'ホーム', href: '/' }, { label: 'レビュー', href: '/review/' }, { label: tag.label, href: getReviewTagLink(tag.slug) + '/' }, { label: `${page}ページ目` }];
const pagination = { currentPage: page, totalPages: getTotalPages(total), totalItems: total, baseUrl: getReviewTagLink(tag.slug) };
---

<Layout title={`${title}（${page}ページ目）`} description={`${tag.label}のウイスキーをストレート・ロック・ハイボールで飲み比べたレビューの一覧です。`}>
  <ReviewListPage title={title} posts={posts} allPosts={allPosts} currentTag={tag.slug} pagination={pagination} breadcrumb={breadcrumb} />
</Layout>
