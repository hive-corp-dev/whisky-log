---
import Layout from '@/layouts/Layout.astro';
import ReviewListPage from '@/components/pages/review/ReviewListPage.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { reviewCategories } from '@/data/review/category';
import { getSortedReviewPosts } from '@/utils/review/posts';
import { getReviewCategoryLink } from '@/utils/review/slugs';
import { getTotalPages, slicePage } from '@/utils/review/pagination';

export async function getStaticPaths() {
  const reviewPosts = await getCollection('review', ({ data }) => data.draft === false);

  // 記事が1件以上あるカテゴリだけページを生成する
  return reviewCategories.flatMap((category) => {
    const posts = reviewPosts.filter((post) => post.data.category === category.slug);
    if (posts.length === 0) return [];
    const sorted = getSortedReviewPosts(posts);
    return [{ params: { category: category.slug }, props: { category, posts: slicePage(sorted, 1), total: sorted.length, allPosts: reviewPosts } }];
  });
}

interface Props {
  category: (typeof reviewCategories)[number];
  posts: CollectionEntry<'review'>[];
  total: number;
  allPosts: CollectionEntry<'review'>[];
}

const { category, posts, total, allPosts } = Astro.props;
const title = `${category.label}ウイスキーのレビュー一覧`;
const breadcrumb = [{ label: 'ホーム', href: '/' }, { label: 'レビュー', href: '/review/' }, { label: category.label }];
const pagination = { currentPage: 1, totalPages: getTotalPages(total), totalItems: total, baseUrl: getReviewCategoryLink(category.slug) };
---

<Layout title={title} description={`${category.label}ウイスキーをストレート・ロック・ハイボールで飲み比べたレビューの一覧です。`}>
  <ReviewListPage title={title} posts={posts} allPosts={allPosts} currentCategory={category.slug} pagination={pagination} breadcrumb={breadcrumb} />
</Layout>
