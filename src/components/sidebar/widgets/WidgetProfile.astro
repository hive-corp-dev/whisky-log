---
import { Image } from "astro:assets";
import { FaXTwitter, FaEnvelope } from "react-icons/fa6";
import imgProfile from '@/assets/images/profile.png';
import { X_PROFILE_URL, SITE_NAME, SITE_DESCRIPTION_PARAGRAPHS } from '@/data/siteData';
---

<div class="widget">
  <div class="img-wrap">
    <Image src={imgProfile} alt={`${SITE_NAME}のアイコン`} />
  </div>
  <p class="name">{SITE_NAME}</p>
  <div class="profile-text">
    {SITE_DESCRIPTION_PARAGRAPHS.map((p) => <p>{p}</p>)}
  </div>
  <div class="sns">
    <a href={X_PROFILE_URL} target="_blank" rel="noopener noreferrer" class="sns-icon" aria-label="X (旧Twitter)"><FaXTwitter /></a>
    <a href="/contact/" class="sns-icon" aria-label="お問い合わせ"><FaEnvelope /></a>
  </div>
</div>

<style lang="scss">
  .widget {
    border: .1rem solid var.$c-line;
    border-radius: .6rem;
    background-color: var.$c-white;
    padding: 2.4rem;
  }

  .img-wrap {
    width: 8rem;
    height: 8rem;
    border-radius: 50%;
    overflow: hidden;
    margin: 0 auto;

    img {
      height: 100%;
      object-fit: cover;
    }
  }

  .name {
    font-size: 1.4rem;
    font-weight: bold;
    text-align: center;
    color: rgba(var.$c-text, .8);
    margin-top: 1.2rem;
  }

  .profile-text {
    margin-top: 1.2rem;
    font-size: 1.3rem;

    p {
      margin-bottom: 1.2rem;
    }
  }

  .sns {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .8rem;
    margin-top: 2.4rem;

    @include mixin.sp {
      margin-top: 4rem;
    }
  }

  .sns-icon {
    width: 3.6rem;
    height: 3.6rem;
    background-color: var.$c-main;
    color: var.$c-white;
    border: .1rem solid var.$c-main;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: all .3s;

    // ホバーで色反転（白背景・オレンジの縁・オレンジのアイコン）
    @include mixin.hover {
      &:hover {
        background-color: var.$c-white;
        color: var.$c-main;
      }
    }
  }
</style>
