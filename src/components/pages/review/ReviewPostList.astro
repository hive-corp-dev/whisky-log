---
import type { CollectionEntry } from "astro:content";
import ReviewPostCard from '@/components/pages/review/ReviewPostCard.astro';

interface Props {
  reviewPosts: CollectionEntry<'review'>[];
}

const { reviewPosts } = Astro.props;
---

<ul class="list">
  {
    reviewPosts.map((reviewPost) => (
      <li class="item">
        <ReviewPostCard article={reviewPost} />
      </li>
    ))
  }
</ul>

<style lang="scss">
  .list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.8rem 2.4rem;
    margin-top: 3.2rem;

    @include mixin.tab {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @include mixin.sp {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.4rem;
      margin-top: 2.4rem;
    }
  }

  .item {
    display: flex;
    flex-direction: column;
  }
</style>
