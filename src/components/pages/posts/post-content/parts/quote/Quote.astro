---
// 引用ボックス。公式のテイスティングノートなど、他サイトの文章を引用するときに使う。
//   <Quote source="キリン公式サイト" href="https://www.kirin.co.jp/...">
//   ほのかな甘い香りと澄んだ口あたり。
//   </Quote>
// source は出典の名前（必須）。href はあれば出典名がリンクになり、なければ文字だけ出す。
// 中身は Markdown のまま書ける（段落を分けたいときは空行）。
interface Props {
  /** 出典の名前（サイト名・資料名） */
  source: string;
  /** 出典の URL。省略可 */
  href?: string;
}

const { source, href } = Astro.props;
---

<figure class="quote">
  <blockquote class="body">
    <slot />
  </blockquote>
  <figcaption class="source">
    <span class="source-label">出典</span>
    {
      href ? (
        <a href={href} target="_blank" rel="nofollow noopener noreferrer" class="source-link">{source}</a>
      ) : (
        <span class="source-name">{source}</span>
      )
    }
  </figcaption>
</figure>

<style lang="scss">
  .quote {
    margin: 2.4rem 0;
    font-size: 1.5rem;
    line-height: 1.9;

    @include mixin.sp {
      font-size: 1.4rem;
    }
  }

  .body {
    // 本文の p のマージンを引用の中では詰める
    :global(p) {
      margin: 0 !important;
    }

    :global(p + p) {
      margin-top: 0.8em !important;
    }
  }

  .source {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1.2rem;
    color: var.$c-text-gray;
  }

  .source-label {
    flex: none;
    font-weight: bold;
    letter-spacing: 0.08em;
  }

  .source-link {
    color: var.$c-main;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    word-break: break-all;
    transition: opacity 0.2s;

    @include mixin.hover {
      &:hover {
        opacity: 0.7;
      }
    }
  }

  // 引用符の飾り: 左上に「“」、右下に「”」。ボックスの端から離して置く
  .quote {
    position: relative;
    padding: 3.2rem 3.2rem 2.8rem 3.4rem;
    border-left: 0.4rem solid var.$c-main;
    border-radius: 0 0.6rem 0.6rem 0;
    background-color: var.$c-bg;

    @include mixin.sp {
      padding: 2.8rem 2.6rem 2.4rem 2.8rem;
    }

    &::before,
    &::after {
      position: absolute;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 3.6rem;
      line-height: 1;
      color: var.$c-main;
      opacity: 0.6;
      pointer-events: none;

      @include mixin.sp {
        font-size: 3rem;
      }
    }

    &::before {
      content: "\201C";
      top: 1.4rem;
      left: 1.6rem;

      @include mixin.sp {
        top: 1.2rem;
        left: 1.2rem;
      }
    }

    // 「”」の字形は行ボックスの上寄りに描かれるので、その分だけ下にずらして
    // 見た目の距離を上の「“」と同じ（上 1.4rem / 下 1.4rem）にそろえる
    &::after {
      content: "\201D";
      right: 1.6rem;
      bottom: 1.4rem;
      transform: translateY(45%);

      @include mixin.sp {
        right: 1.2rem;
        bottom: 1.2rem;
      }
    }
  }

  .source {
    margin-top: 1.2rem;
    padding-right: 2.8rem; // 右下の引用符と重ならないように
  }
</style>
