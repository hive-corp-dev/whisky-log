---
const {position = 'left', style = 'border'} = Astro.props;
import imgProfile from '@/assets/images/profile.png';
import { Image } from 'astro:assets';
---

<div class:list={['wrap', position]}>
  <div class="icon">
    <Image src={imgProfile} alt='プロフィール画像' />
  </div>
  <div class="speech">
    <div class:list={["content", style]}>
      <slot />
    </div>
  </div>
</div>

<style lang="scss">
  .wrap {
    display: flex;
    gap: 1.6rem;

    @include mixin.sp {
      gap: 1.2rem;
    }

    &.left {
      flex-direction: row;
    }

    &.right {
      flex-direction: row-reverse;

      .speech {
        justify-content: flex-start;

        .content {

          &::before {
            left: auto;
            right: -2rem;
            clip-path: polygon(0 0, 100% 50%, 0 100%);
            
            @include mixin.sp {
              right: -1.4rem;
            }
          }

          &.border {
            &::before, &::after {
              left: auto;
              clip-path: polygon(0 0, 100% 50%, 0 100%);
            }

            &::before {
              right: -2rem;

              @include mixin.sp {
                right: -1.8rem;
              }
            }

            &::after {
              right: -1.6rem;

              @include mixin.sp {
                right: -1.4rem;
              }
            }
          }
        }
      }
    }
  }

  .icon {
    width: 7rem;
    height: 7rem;
    border-radius: 50%;
    overflow: hidden;
    border: .2rem solid #f0f0f0;
    flex-shrink: 0;

    @include mixin.sp {
      width: 5rem;
      height: 5rem;
    }
  }

  .speech {
    flex-grow: 1;
    display: flex;
    justify-content: flex-end;
  }

  .content {
    position: relative;
    padding: 1.6rem;
    border-radius: 1rem;
    background-color: #fff;
    width: calc(100% - 2rem);
    font-size: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;

    @include mixin.sp {
      font-size: 1.5rem;
      width: calc(100% - 1.6rem);
      gap: 1.2rem;
    }

    :global(ul) {
      padding: 0;
      background-color: transparent;
    }

    &.border {
      border: .2rem solid #e5e5e5;

      &::before, &::after {
        content: '';
        position: absolute;
      }

      &::before {
        left: -2rem;
        top: 2rem;
        background-color: #e5e5e5;
        width: 2rem;
        height: 2.4rem;
        clip-path: polygon(0 50%, 100% 0, 100% 100%); 

        @include mixin.sp {
          left: -1.8rem;
          top: 1.4rem;
          width: 1.6rem;
          height: 2rem;
        }
      }

      &::after {
        left: -1.6rem;
        top: 2rem;
        background-color: #fff;
        width: 2rem;
        height: 2.4rem;
        clip-path: polygon(0 50%, 100% 0, 100% 100%); 

        @include mixin.sp {
          top: 1.4rem;
          left: -1.4rem;
          width: 1.6rem;
          height: 2rem;
        }
      }
    }

    &.gray {
      background-color: #f4f4f4;

      &::before {
        content: '';
        position: absolute;
        left: -2rem;
        top: 2.2rem;
        background-color: #f4f4f4;
        width: 2rem;
        height: 2.4rem;
        clip-path: polygon(0 50%, 100% 0, 100% 100%); 

        @include mixin.sp {
          left: -1.4rem;
          top: 1.4rem;
          width: 1.6rem;
          height: 2rem;
        }
      }
    }

    &.blue {
      background-color: #e1f4fc;

      &::before {
        content: '';
        position: absolute;
        left: -2rem;
        top: 2.2rem;
        background-color: #e1f4fc;
        width: 2rem;
        height: 2.4rem;
        clip-path: polygon(0 50%, 100% 0, 100% 100%); 

        @include mixin.sp {
          left: -1.4rem;
          top: 1.4rem;
          width: 1.6rem;
          height: 2rem;
        }
      }
    }

    &.orange {
      background-color: #ffebdc;

      &::before {
        content: '';
        position: absolute;
        left: -2rem;
        top: 2.2rem;
        background-color: #ffebdc;
        width: 2rem;
        height: 2.4rem;
        clip-path: polygon(0 50%, 100% 0, 100% 100%); 

        @include mixin.sp {
          left: -1.4rem;
          top: 1.4rem;
          width: 1.6rem;
          height: 2rem;
        }
      }
    }

    &.yellow {
      background-color: #fff5d6;

      &::before {
        content: '';
        position: absolute;
        left: -2rem;
        top: 2.2rem;
        background-color: #fff5d6;
        width: 2rem;
        height: 2.4rem;
        clip-path: polygon(0 50%, 100% 0, 100% 100%); 

        @include mixin.sp {
          left: -1.4rem;
          top: 1.4rem;
          width: 1.6rem;
          height: 2rem;
        }
      }
    }
  }
</style>
