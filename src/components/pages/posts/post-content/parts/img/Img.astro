---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt } = Astro.props;

// 記事本文の最大幅は約 800px。元写真は 4000px 超なので縮小版を配信する
const widths = [480, 800, 1200];
const sizes = "(max-width: 768px) 100vw, 800px";
---

<Image class="img" src={src} alt={alt} width={1200} widths={widths} sizes={sizes} loading="lazy" />
