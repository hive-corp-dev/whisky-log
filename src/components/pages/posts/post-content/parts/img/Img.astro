---
// 記事本文の写真。
//   <Img src={photo} alt="…" />
// 飲み比べの写真のように、写っているものの真下に名前を置きたいときは labels を渡す。
//   <Img src={photo} alt="…" labels={[{ text: "12年", x: 36 }, { text: "15年", x: 64 }]} />
// x は写真の左端からの位置（%）。グラスやボトルの中心に合わせる。
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Label {
  /** 表示する名前 */
  text: string;
  /** 写真の左端からの横位置（%）。名前の中央がここに来る */
  x: number;
}

interface Props {
  src: ImageMetadata;
  alt: string;
  /** 写真の下、被写体の真下に並べる名前。省略すると写真だけ出す */
  labels?: Label[];
}

const { src, alt, labels } = Astro.props;

// 記事本文の最大幅は約 800px。元写真は 4000px 超なので縮小版を配信する
const widths = [480, 800, 1200];
const sizes = "(max-width: 768px) 100vw, 800px";
---

{
  labels && labels.length > 0 ? (
    <figure class="labeled">
      <Image class="img" src={src} alt={alt} width={1200} widths={widths} sizes={sizes} loading="lazy" />
      <figcaption class="labels">
        {labels.map((label) => (
          <span class="label" style={`left: ${label.x}%`}>
            {label.text}
          </span>
        ))}
      </figcaption>
    </figure>
  ) : (
    <Image class="img" src={src} alt={alt} width={1200} widths={widths} sizes={sizes} loading="lazy" />
  )
}

<style lang="scss">
  // 名前の行。写真と同じ幅の中で、各名前を被写体の真下（left: x%）に置く
  .labels {
    position: relative;
    height: 2.4rem;
    margin-top: 1rem;
    font-size: 1.5rem;
    line-height: 2.4rem;
    text-align: left;
    color: var.$c-text;

    @include mixin.sp {
      height: 2.2rem;
      margin-top: 0.8rem;
      font-size: 1.3rem;
      line-height: 2.2rem;
    }
  }

  .label {
    position: absolute;
    top: 0;
    font-weight: bold;
    white-space: nowrap;
    transform: translateX(-50%);
  }
</style>
