---
// 比較記事の「どれを選ぶべきか」で、条件の見出し（### …）の下に置く 1 件分。
// 薄い琥珀の帯に「商品画像・おすすめ・銘柄名」を出し、その下に理由の文を普通の本文として出す。
//   ### ハイボールを中心に飲みたい
//
//   <ComparePick id="glenfiddich-12" name="グレンフィディック12年">
//     炭酸で割ると…
//   </ComparePick>
// id は楽天の商品キャッシュ（src/data/rakuten/items.json）のキー。帯全体を楽天の商品ページへのリンクにする
// （楽天の商品画像はリンクとセットで使う決まり）。商品情報が無いときは、画像なし・リンクなしの帯になる。
import { getRakutenItem } from "@/utils/review/rakuten";

interface Props {
  id: string;
  /** おすすめの銘柄名（例: "グレンフィディック12年"） */
  name: string;
}

const { id, name } = Astro.props;

const item = getRakutenItem(id);
const href = item?.affiliateUrl ?? item?.itemUrl;
const hasLink = Boolean(item?.imageUrl && href);
const Bar = hasLink ? "a" : "div";
const linkAttrs = hasLink
  ? {
      href,
      target: "_blank",
      rel: "nofollow sponsored noopener",
      "aria-label": `${name}を楽天市場で見る`,
      "data-aff-shop": "rakuten",
      "data-aff-item": id,
      "data-aff-part": "pick",
    }
  : {};
---

<div class="pick">
  <Bar class:list={["bar", { "no-image": !hasLink }]} {...linkAttrs}>
    {
      hasLink && (
        <span class="image">
          <img src={item?.imageUrl} alt="" width="120" height="120" loading="lazy" decoding="async" />
        </span>
      )
    }
    <span class="text">
      <span class="label">おすすめ</span>
      <span class="name">{name}</span>
    </span>
  </Bar>
  <div class="reason">
    <slot />
  </div>
</div>

<style lang="scss">
  .bar {
    display: grid;
    grid-template-columns: 7.2rem minmax(0, 1fr);
    align-items: center;
    gap: 2rem;
    padding: 1.2rem 2.4rem 1.2rem 1.6rem;
    border-radius: 0.8rem;
    background-color: var.$c-main-light;
    transition: opacity 0.2s;

    @include mixin.sp {
      grid-template-columns: 6.4rem minmax(0, 1fr);
      gap: 1.4rem;
      padding: 1rem 1.4rem 1rem 1rem;
    }

    &.no-image {
      grid-template-columns: minmax(0, 1fr);
      padding: 1.6rem 2.4rem;

      @include mixin.sp {
        padding: 1.2rem 1.6rem;
      }
    }
  }

  a.bar {
    @include mixin.hover {
      &:hover {
        opacity: 0.8;
      }
    }
  }

  .image img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    // 楽天の商品画像は白背景なので、乗算で帯の地色になじませる
    mix-blend-mode: multiply;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .label {
    color: var.$c-main;
    font-size: 1.2rem;
    font-weight: bold;
    letter-spacing: 0.1em;
    line-height: 1.4;
  }

  .name {
    font-size: 2.2rem;
    font-weight: bold;
    line-height: 1.4;

    @include mixin.sp {
      font-size: 1.8rem;
    }
  }

  .reason {
    margin-top: 1.5em;

    :global(p + p) {
      margin-top: 1.5em;
    }
  }
</style>
