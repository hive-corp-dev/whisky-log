---
import imgProfile from '@/assets/images/profile.png'
import { Image } from 'astro:assets'
---

<header class="header">
  <a class="logo" href="/">
    <Image class="logo-img" src={imgProfile} alt='whisky log' />
    <h1 class="title">Whisky Log</h1>
  </a>

  <nav class="nav">
    <ul class="list">
      <li class="item">
        <a href="/" class="link">ホーム</a>
      </li>
      <li class="item">
        <a href="/review" class="link">レビュー</a>
      </li>
    </ul>
  </nav>
</header>

<style lang="scss">
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 8rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 3.2rem;
    z-index: var.$z-header;
    background-color: var.$c-white;
    border-bottom: .1rem solid rgba(var.$c-text, .1);

    @include mixin.sp {
      height: 6.4rem;
      padding: 0 2rem;
    }
  }

  .logo {
    display: flex;
    align-items: center;
  }

  .logo-img {
    width: 4.8rem;
    height: 4.8rem;
    border-radius: 50%;
    overflow: hidden;
    margin-right: 1.2rem;

    @include mixin.sp {
      width: 3.2rem;
      height: 3.2rem;
      margin-right: .8rem;
    }
  }

  .title {
		font-family: var.$font-line;
		font-size: 2rem;
		font-weight: bold;
		letter-spacing: 0.05em;

    @include mixin.sp {
      font-size: 1.4rem;
    }
	}

  .list {
    display: flex;
    gap: 1.6rem;
  }

  .link {
    font-size: 1.3rem;
    font-weight: bold;
    letter-spacing: .08em;

    @include mixin.sp {
      font-size: 1.2rem;
    }
  }
</style>
